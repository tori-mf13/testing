generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ────────────────────────────────────────────────

enum UserRole {
  ADMIN
  IT_STAFF
  MANAGER
  READ_ONLY
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            UserRole  @default(READ_ONLY)
  department      String?
  jobTitle        String?
  avatarUrl       String?
  mfaEnabled      Boolean   @default(false)
  mfaMethod       String?
  lastLogin       DateTime?
  isActive        Boolean   @default(true)
  oktaId          String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignedAssets     Asset[]
  tickets            Ticket[]        @relation("TicketCreator")
  assignedTickets    Ticket[]        @relation("TicketAssignee")
  accessRequests     AccessRequest[] @relation("AccessRequester")
  approvalActions    AccessRequest[] @relation("AccessApprover")
  purchaseRequests   PurchaseRequest[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  workflowExecutions WorkflowExecution[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ─── SaaS Management ─────────────────────────────────────────────

enum SaaSStatus {
  ACTIVE
  INACTIVE
  PENDING_REVIEW
  SHADOW_IT
  DECOMMISSIONING
}

model SaaSApplication {
  id              String     @id @default(uuid())
  name            String
  vendor          String?
  owner           String?
  category        String?
  description     String?
  licenseCount    Int        @default(0)
  activeUsers     Int        @default(0)
  monthlyCost     Float      @default(0)
  annualCost      Float      @default(0)
  utilizationPct  Float      @default(0)
  renewalDate     DateTime?
  status          SaaSStatus @default(ACTIVE)
  isShadowIT      Boolean    @default(false)
  ssoEnabled      Boolean    @default(false)
  logoUrl         String?
  website         String?
  contractUrl     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  licenses        SaaSLicense[]
  costHistory     SaaSCostHistory[]

  @@index([status])
  @@index([name])
}

model SaaSLicense {
  id            String          @id @default(uuid())
  appId         String
  app           SaaSApplication @relation(fields: [appId], references: [id], onDelete: Cascade)
  userEmail     String
  assignedDate  DateTime        @default(now())
  lastUsed      DateTime?
  isActive      Boolean         @default(true)
  reclaimable   Boolean         @default(false)
  createdAt     DateTime        @default(now())

  @@index([appId])
  @@index([userEmail])
}

model SaaSCostHistory {
  id        String          @id @default(uuid())
  appId     String
  app       SaaSApplication @relation(fields: [appId], references: [id], onDelete: Cascade)
  month     DateTime
  cost      Float
  createdAt DateTime        @default(now())

  @@index([appId, month])
}

// ─── Identity & Access Management ────────────────────────────────

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

model AccessRequest {
  id           String              @id @default(uuid())
  requesterId  String
  requester    User                @relation("AccessRequester", fields: [requesterId], references: [id])
  approverId   String?
  approver     User?               @relation("AccessApprover", fields: [approverId], references: [id])
  resourceType String
  resourceName String
  accessLevel  String
  justification String?
  status       AccessRequestStatus @default(PENDING)
  decidedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([requesterId])
  @@index([status])
}

model OrphanedAccount {
  id           String   @id @default(uuid())
  service      String
  username     String
  email        String?
  lastActivity DateTime?
  detectedAt   DateTime @default(now())
  resolved     Boolean  @default(false)
  resolvedAt   DateTime?

  @@index([resolved])
}

// ─── Asset Management ────────────────────────────────────────────

enum AssetType {
  LAPTOP
  DESKTOP
  SERVER
  MOBILE
  TABLET
  NETWORK_DEVICE
  PRINTER
  MONITOR
  OTHER
}

enum AssetStatus {
  IN_USE
  AVAILABLE
  MAINTENANCE
  RETIRED
  LOST
  STORAGE
}

model Asset {
  id              String      @id @default(uuid())
  name            String
  assetTag        String      @unique
  type            AssetType
  manufacturer    String?
  model           String?
  serialNumber    String?     @unique
  assignedUserId  String?
  assignedUser    User?       @relation(fields: [assignedUserId], references: [id])
  department      String?
  location        String?
  purchaseDate    DateTime?
  purchaseCost    Float?
  warrantyExpiry  DateTime?
  osName          String?
  osVersion       String?
  patchStatus     String?     @default("Unknown")
  lastPatchDate   DateTime?
  status          AssetStatus @default(AVAILABLE)
  ipAddress       String?
  macAddress       String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([type])
  @@index([status])
  @@index([assignedUserId])
  @@index([assetTag])
}

// ─── Security & Compliance ───────────────────────────────────────

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum AlertStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

model SecurityAlert {
  id          String        @id @default(uuid())
  title       String
  description String?
  source      String
  severity    AlertSeverity
  status      AlertStatus   @default(OPEN)
  affectedAsset String?
  assignedTo  String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([severity])
  @@index([status])
}

model ComplianceFramework {
  id             String   @id @default(uuid())
  name           String
  description    String?
  totalControls  Int      @default(0)
  passedControls Int      @default(0)
  failedControls Int      @default(0)
  progressPct    Float    @default(0)
  lastAuditDate  DateTime?
  nextAuditDate  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  controls       ComplianceControl[]
}

model ComplianceControl {
  id            String              @id @default(uuid())
  frameworkId   String
  framework     ComplianceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  controlId     String
  title         String
  description   String?
  status        String              @default("Not Started")
  evidence      String?
  lastChecked   DateTime?
  createdAt     DateTime            @default(now())

  @@index([frameworkId])
}

model Vulnerability {
  id           String   @id @default(uuid())
  cveId        String?
  title        String
  description  String?
  severity     AlertSeverity
  affectedAsset String?
  patchAvailable Boolean @default(false)
  patched      Boolean  @default(false)
  discoveredAt DateTime @default(now())
  patchedAt    DateTime?

  @@index([severity])
  @@index([patched])
}

// ─── On-Prem / Hybrid Infrastructure ────────────────────────────

enum ServerStatus {
  ONLINE
  OFFLINE
  DEGRADED
  MAINTENANCE
}

model Server {
  id            String       @id @default(uuid())
  hostname      String       @unique
  ipAddress     String?
  type          String
  os            String?
  cpuCores      Int?
  ramGB         Float?
  diskGB        Float?
  cpuUsagePct   Float?
  ramUsagePct   Float?
  diskUsagePct  Float?
  environment   String?
  cloudProvider String?
  region        String?
  status        ServerStatus @default(ONLINE)
  adSynced      Boolean      @default(false)
  lastHeartbeat DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  metrics       ServerMetric[]

  @@index([status])
  @@index([hostname])
}

model ServerMetric {
  id          String   @id @default(uuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  cpuPct      Float
  ramPct      Float
  diskPct     Float
  networkIn   Float?
  networkOut  Float?
  timestamp   DateTime @default(now())

  @@index([serverId, timestamp])
}

// ─── Network Management ─────────────────────────────────────────

enum NetworkDeviceType {
  SWITCH
  FIREWALL
  ACCESS_POINT
  ROUTER
  VPN_GATEWAY
  LOAD_BALANCER
  OTHER
}

model NetworkDevice {
  id            String            @id @default(uuid())
  name          String
  type          NetworkDeviceType
  manufacturer  String?
  model         String?
  ipAddress     String?
  macAddress    String?
  location      String?
  firmware      String?
  isOnline      Boolean           @default(true)
  uptimePct     Float             @default(100)
  bandwidthIn   Float?
  bandwidthOut  Float?
  lastSeen      DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([type])
  @@index([isOnline])
}

// ─── Procurement ─────────────────────────────────────────────────

enum PurchaseRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseRequest {
  id            String                @id @default(uuid())
  requesterId   String
  requester     User                  @relation(fields: [requesterId], references: [id])
  title         String
  description   String?
  vendor        String?
  estimatedCost Float
  actualCost    Float?
  department    String?
  priority      String                @default("Normal")
  status        PurchaseRequestStatus @default(DRAFT)
  approvedBy    String?
  approvedAt    DateTime?
  orderedAt     DateTime?
  receivedAt    DateTime?
  poNumber      String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  items         PurchaseItem[]

  @@index([requesterId])
  @@index([status])
}

model PurchaseItem {
  id          String          @id @default(uuid())
  requestId   String
  request     PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name        String
  quantity    Int             @default(1)
  unitCost    Float
  totalCost   Float

  @@index([requestId])
}

model Vendor {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  website     String?
  category    String?
  rating      Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Password Management ─────────────────────────────────────────

model PasswordHealth {
  id              String   @id @default(uuid())
  userEmail       String
  totalPasswords  Int      @default(0)
  weakPasswords   Int      @default(0)
  reusedPasswords Int      @default(0)
  oldPasswords    Int      @default(0)
  breachedCount   Int      @default(0)
  healthScore     Float    @default(0)
  lastChecked     DateTime @default(now())

  @@index([userEmail])
}

// ─── Data Retention ──────────────────────────────────────────────

enum RetentionAction {
  ARCHIVE
  DELETE
  ANONYMIZE
  NOTIFY
}

model RetentionPolicy {
  id             String          @id @default(uuid())
  name           String
  dataType       String
  retentionDays  Int
  action         RetentionAction @default(ARCHIVE)
  isActive       Boolean         @default(true)
  description    String?
  lastExecuted   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ErasureRequest {
  id           String   @id @default(uuid())
  subjectEmail String
  subjectName  String?
  requestType  String   @default("GDPR Right to Erasure")
  status       String   @default("Pending")
  dataSystems  String[]
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

// ─── Help Desk ───────────────────────────────────────────────────

enum TicketPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  WAITING_ON_VENDOR
  RESOLVED
  CLOSED
}

model Ticket {
  id            String         @id @default(uuid())
  title         String
  description   String?
  category      String?
  priority      TicketPriority @default(MEDIUM)
  status        TicketStatus   @default(OPEN)
  creatorId     String
  creator       User           @relation("TicketCreator", fields: [creatorId], references: [id])
  assigneeId    String?
  assignee      User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  slaDeadline   DateTime?
  resolvedAt    DateTime?
  closedAt      DateTime?
  csatScore     Int?
  csatComment   String?
  aiSuggestion  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  comments      TicketComment[]

  @@index([status])
  @@index([priority])
  @@index([creatorId])
  @@index([assigneeId])
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  content   String
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ─── AI Automation Engine ────────────────────────────────────────

model Workflow {
  id           String   @id @default(uuid())
  name         String
  description  String?
  triggerType  String
  triggerConfig String?
  conditions   String?
  actions      String?
  isActive     Boolean  @default(true)
  isBuiltIn    Boolean  @default(false)
  runCount     Int      @default(0)
  hoursSaved   Float    @default(0)
  costRecovered Float   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  executions   WorkflowExecution[]
}

model WorkflowExecution {
  id          String   @id @default(uuid())
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  triggeredBy String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  status      String   @default("Running")
  result      String?
  startedAt   DateTime @default(now())
  completedAt DateTime?

  @@index([workflowId])
  @@index([status])
}

// ─── Reporting ───────────────────────────────────────────────────

model ReportTemplate {
  id          String   @id @default(uuid())
  name        String
  module      String
  description String?
  queryConfig String?
  schedule    String?
  recipients  String[]
  format      String   @default("PDF")
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Settings & Integrations ─────────────────────────────────────

model Integration {
  id          String   @id @default(uuid())
  name        String
  type        String
  config      String?
  apiKey      String?
  oauthToken  String?
  isActive    Boolean  @default(true)
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── System-wide ─────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String?
  type      String   @default("info")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model ActivityFeed {
  id          String   @id @default(uuid())
  type        String
  title       String
  description String?
  module      String?
  entityId    String?
  userId      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([module])
}
